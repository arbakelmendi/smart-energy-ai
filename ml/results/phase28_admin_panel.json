{
  "phase": 28,
  "title": "Full Administrator Management Panel and Cross-Owner Administration",
  "date": "2026-10-23",
  "status": "complete",
  "endpoints": {
    "GET /admin/overview": "Eight factual application-wide SQL counts",
    "GET /admin/users": "Paginated safe users; email/name search, role and active filters",
    "GET /admin/users/{user_id}": "Safe account and owned domain counts",
    "PATCH /admin/users/{user_id}/status": "Strict boolean, self/final-admin protection, transactional all-session revocation",
    "GET /admin/buildings": "Paginated cross-owner metadata, owner and measurement/prediction counts; search/owner/type filters",
    "GET /admin/buildings/{building_id}": "Safe read-only metadata, owner, measurement range and latest saved forecast summary",
    "GET /admin/predictions": "Paginated newest-saved-first forecast activity with owner/building context"
  },
  "authorization": "Every dedicated admin endpoint enforces existing active-session require_admin: anonymous401, USER403. Ordinary owner-only APIs unchanged, including ADMIN; PATCH retains CSRF/trusted-origin guard. Private admin responses no-store.",
  "overview_fields": [
    "total_users",
    "active_users",
    "inactive_users",
    "admin_users",
    "regular_users",
    "total_buildings",
    "total_measurements",
    "total_predictions"
  ],
  "status_policy": {
    "request": "Strict is_active boolean only",
    "deactivation": "Explicit UI confirmation; server transaction updates target and deletes all AuthSession rows; domain data retained",
    "reactivation": "Allows new login, never restores old sessions",
    "self_deactivation": "409 rejection; own UI action disabled",
    "final_active_admin": "409 rejection; row locks where supported and atomic conditional UPDATE; concurrent SQLite test preserves >=1 active administrator",
    "role_editing": "Omitted; existing create_admin.py provisions ADMIN",
    "user_deletion": "Unsupported",
    "password_reset": "Unsupported"
  },
  "data_access": {
    "aggregation": "SQL counts/grouped joins/subqueries; no list-row N+1 child queries; bounded page queries",
    "pagination": "Default50, maximum200, nonnegative signed64-bit offset",
    "ordering": "Users/buildings ID ASC; predictions created_at DESC then ID DESC",
    "search": "Whitespace normalization, literal escaped substring search; SQLite comparison/Unicode behavior documented",
    "safe_exclusions": [
      "password_hash",
      "token_hash",
      "auth_sessions",
      "feature_snapshot_json",
      "feature_hash",
      "model_checksum",
      "raw_cookies",
      "environment_secrets"
    ],
    "reference_building": "Ownership unchanged; stored name/description displayed in cross-owner admin view only"
  },
  "frontend": {
    "routes": {
      "/admin": "Factual overview + paginated saved prediction activity",
      "/admin/users": "Filtered list and ?user=ID detail/status/paginated owned buildings",
      "/admin/buildings": "Filtered inventory and ?building=ID read-only detail"
    },
    "navigation": "Existing Administration group shown only for ADMIN; original role guard retained",
    "queries": "admin/acting-user-ID/area/filter/page/detail keys; separate from ordinary owner caches",
    "mutation_coherence": "Server-confirmed status changes invalidate acting-admin user lists/details and overview only",
    "states": [
      "loading",
      "empty",
      "safe backend/malformed-response error",
      "Retry",
      "success"
    ],
    "routeTree": "No new routes; preserve byte-identical pre-existing user state"
  },
  "known_limitations": [
    "SQLite development prototype; live PostgreSQL concurrency not verified",
    "No server push: existing client learns revocation on next request/navigation/focus or60-second auth revalidation; backend session rows removed immediately",
    "A request already authorized before concurrent revocation can finish",
    "Offset pages can move under concurrent database changes",
    "SQLite default Unicode case-folding limits apply to search",
    "No enterprise audit log, login history, cross-owner raw-history mutation, role-editing UI, user deletion or password reset",
    "No scheduler, IoT, savings, confidence intervals, payments, email, MFA or physical control"
  ],
  "migration_dependency_status": "No migration, schema, dependency or lockfile change; existing Phase26 head reused",
